# Copy this file to .env and adjust if needed.
# All values below are the real production values already baked into
# src/config/site.ts — the site works even without a .env file.

# WhatsApp number in international format, digits only.
VITE_WHATSAPP_NUMBER=201032404246

# Google Form URLs (public "viewform" links) — leads land in Google Sheets.
VITE_OWNER_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSfUtjDbrWbivooimln8W812FlExxibToAEHs5QlVLQ0GpqRWw/viewform?usp=header
VITE_SITTER_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSdbM3B2YOE9qorVM2uMltCYjW7P1_gGTZi1JKgAJPz2jcY93w/viewform?usp=header

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=

# Public site URL, used for canonical + Open Graph tags
VITE_SITE_URL=https://catcare.eg
